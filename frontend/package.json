{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "desktop:build": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.3",
    "pdfjs-dist": "^6.5.438",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "vite": "^8.3.6",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.zusy.ai",
    "productName": "ZusyAI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/assets/zusyai.ico"
    }
  },
  "allowScripts": {
    "electron@39.8.10": true
  }
}
